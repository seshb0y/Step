@page
@model MovieRazor.Pages.Search

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="text-center mb-4">Поиск фильма</h2>

            <form method="get">
                <div class="input-group">
                    <input type="text" name="title" class="form-control" placeholder="Введите название фильма" value="@Model.Title">
                    <button class="btn btn-primary" type="submit">Искать</button>
                </div>
            </form>
        </div>
    </div>
    
    @if (Model.SearhByTitleRes != null && Model.SearhByTitleRes.results.Length > 0)
    {
        <div class="container mt-5">
            <div class="row">
                @foreach (var movie in Model.SearhByTitleRes.results)
                {
                   <partial name="Shared/_MoviePartial" model="movie"/>
                }
            </div>
        </div>
    }
    @if (Model.SearhByTitleRes != null)
    {
        <div class="pagination text-center mt-4">
            @if (Model.SearhByTitleRes.page > 1)
            {
                <a asp-page="Search" asp-route-title="@Model.Title" asp-route-currentPage="@(Model.SearhByTitleRes.page - 1)" class="btn btn-secondary me-2">Предыдущая</a>
            }
            <span>Страница @Model.SearhByTitleRes.page из @Model.SearhByTitleRes.total_pages</span>
            @if (Model.SearhByTitleRes.page < Model.SearhByTitleRes.total_pages)
            {
                <a asp-page="Search" asp-route-title="@Model.Title" asp-route-currentPage="@(Model.SearhByTitleRes.page + 1)" class="btn btn-secondary ms-2">Следующая</a>
            }
        </div>
    }
</div>